# Backend runtime
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication - keep this stable after the first deployment
Jwt__Key=replace-with-a-long-random-secret-of-at-least-32-characters
Jwt__Issuer=ClinicManagement.Api
Jwt__Audience=ClinicManagement.Frontend
Jwt__ExpiryMinutes=480

# Exact Vercel origin; comma-separate additional approved origins
FRONTEND_ORIGIN=https://your-clinic.vercel.app

# Cloudinary uploads
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-api-key
Cloudinary__ApiSecret=your-api-secret

# Production database initialization
# First deployment: true runs migrations plus idempotent settings/role/user seeds.
# Later deployments may use SeedOnStartup=false and MigrateOnStartup=true.
Database__SeedOnStartup=true
Database__MigrateOnStartup=false
Seed__IncludeDemoMedicines=false

# Never enable this on live data unless you intentionally want to erase trial
# patients, visits, treatments, bills, payments, medicine and stock records.
RESET_TRIAL_DATA=false

# Used only when clinic_settings is empty. Later changes come from Clinic Settings.
Clinic__Name=Medical Clinic
Clinic__ShortName=Clinic
Clinic__LogoUrl=
Clinic__Phone=
Clinic__Email=
Clinic__Address=
Clinic__Currency=UGX
Clinic__Timezone=Africa/Kampala
Clinic__PrimaryContact=
Clinic__ReceiptFooter=

# Initial production accounts. Seeds are idempotent and do not overwrite users.
BootstrapUsers__Doctor__Email=doctor@clinic.example
BootstrapUsers__Doctor__Password=replace-with-a-strong-unique-password
BootstrapUsers__Doctor__FirstName=Clinic
BootstrapUsers__Doctor__LastName=Doctor
BootstrapUsers__Nurse__Email=nurse@clinic.example
BootstrapUsers__Nurse__Password=replace-with-a-strong-unique-password
BootstrapUsers__Nurse__FirstName=Clinic
BootstrapUsers__Nurse__LastName=Nurse
BootstrapUsers__Cashier__Email=cashier@clinic.example
BootstrapUsers__Cashier__Password=replace-with-a-strong-unique-password
BootstrapUsers__Cashier__FirstName=Clinic
BootstrapUsers__Cashier__LastName=Cashier

# Frontend (set this in Vercel, not Render)
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
